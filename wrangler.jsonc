{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tools",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "pnpm build"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  }
}
